{
  "name": "vscode-tester",
  "displayName": "Tester Language Support by Linhanmic",
  "description": "Tester Language Support by Linhanmic",
  "version": "0.0.1",
  "author": "Linhanmic",
  "icon": "icons/icon.png",
  "contributors": [
    {
      "name": "Linhanmic",
      "email": "lihanmic@qq.com"
    }
  ],
  "license": "MIT",
  "publisher": "Linhanmic",
  "repository": {
    "type": "git",
    "url": "https://github.com/Linhanmic/vscode-tester"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "activationEvents": [
    "onLanguage:tester"
  ],
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "tester",
    "autocompletion",
    "CAN",
    "automotive"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tester",
        "aliases": [
          "Tester",
          "tester"
        ],
        "extensions": [
          ".txt",
          ".tester"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tester",
        "scopeName": "source.tester",
        "path": "./syntaxes/tester.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tester",
        "path": "./snippets/tester.code-snippets"
      }
    ],
    "configuration": {
      "title": "Tester Language",
      "properties": {
        "tester.dbcFilePath": {
          "type": "string",
          "default": "",
          "description": "DBC 文件路径。为空时自动搜索工作区中的第一个 .dbc 文件。"
        }
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/emscripten": "^1.41.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "candied": "^2.2.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "fs-extra": "^11.3.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "web-tree-sitter": "^0.26.6"
  }
}
