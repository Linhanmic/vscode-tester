{
  "name": "vscode-tester",
  "displayName": "Tester Language Support by Linhanmic",
  "description": "Tester Language Support by Linhanmic",
  "version": "0.0.1",
  "author": "Linhanmic",
  "icon": "icons/icon.png",
  "contributors": [
    {
      "name": "Linhanmic",
      "email": "lihanmic@qq.com"
    }
  ],
  "license": "MIT",
  "publisher": "Linhanmic",
  "repository": {
    "type": "git",
    "url": "https://github.com/Linhanmic/vscode-tester"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "activationEvents": [
    "onLanguage:tester",
    "onCommand:tester.openStudio",
    "onCommand:tester.runTestSuite",
    "onCommand:tester.runTestCase",
    "onCommand:tester.runTestCommand",
    "onCommand:tester.busMonitor.clear"
  ],
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "tester",
    "autocompletion",
    "validation",
    "CAN",
    "automotive"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tester",
        "aliases": [
          "Tester",
          "tester"
        ],
        "extensions": [
          ".txt",
          ".tester"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tester",
        "scopeName": "source.tester",
        "path": "./syntaxes/tester.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tester",
        "path": "./snippets/tester.code-snippets"
      }
    ],
    "configuration": {
      "title": "Tester Language",
      "properties": {
        "tester.dbcFilePath": {
          "type": "string",
          "default": "",
          "description": "DBC 文件路径。为空时自动搜索工作区中的第一个 .dbc 文件。"
        },
        "tester.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用语法诊断"
        },
        "tester.execution.defaultReceiveTimeoutMs": {
          "type": "number",
          "default": 3000,
          "minimum": 1,
          "description": "tcanr print 命令未显式指定等待时间时使用的默认超时时间，单位毫秒。"
        }
      }
    },
    "commands": [
      {
        "command": "tester.openStudio",
        "title": "Tester: 打开 Studio",
        "icon": "$(preview)"
      },
      {
        "command": "tester.runTestSuite",
        "title": "Tester: 运行测试集"
      },
      {
        "command": "tester.runTestCase",
        "title": "Tester: 运行测试用例"
      },
      {
        "command": "tester.runTestCommand",
        "title": "Tester: 运行到命令"
      },
      {
        "command": "tester.busMonitor.clear",
        "title": "Tester: 清空总线监视",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tester.openStudio",
          "when": "resourceLangId == tester",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "tester.openStudio",
          "when": "resourceLangId == tester",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "tester.openStudio",
          "when": "resourceLangId == tester",
          "group": "navigation@1"
        }
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run check-types:webview && npm run lint && node esbuild.js && npm run build:webview",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:webview": "vite build --watch --config webview/vite.config.ts",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run check-types:webview && npm run lint && node esbuild.js --production && npm run build:webview",
    "build:webview": "vite build --config webview/vite.config.ts",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "check-types:webview": "vue-tsc --project webview/tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@types/emscripten": "^1.41.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "fs-extra": "^11.3.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^5.4.20",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "@vscode-tester/zlg-can": "file:../zlg-node",
    "candied": "^2.2.0",
    "vue": "^3.5.22",
    "web-tree-sitter": "^0.26.6"
  }
}
